# https://editorconfig.org
# http://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# 2-space indentation (Google Style Guide Section 4.2)
indent_style = space
indent_size = 2

# Even though Google Style Guide Section 2.3 recommends 100 characters, many
# modern IDEs default to 120 characters, so we follow that convention.
max_line_length = 120

[*.kt]
# Standard Kotlin formatting rules.
ij_kotlin_use_single_name_import = true
ij_kotlin_blank_lines_before_declaration_with_comment_or_annotation_on_separate_line = 1

[*.md]
trim_trailing_whitespace = false
